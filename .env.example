# ===================================================================
# GACKS P.A. V2 — ENVIRONMENT TEMPLATE
# ===================================================================
# SECURITY NOTICE:
# DO NOT place sensitive production API keys or tokens in VITE_* variables.
# VITE_* variables are bundled directly into client-side JavaScript.
# All sensitive secrets must live EXCLUSIVELY in the server environment.
# ===================================================================

# ===================================================================
# 1. PRIVATE SERVER VARIABLES (Used by GACKS Agent Runtime)
# ===================================================================

# Dynamic AI Reasoning Providers (Server-Side Secrets)
# Configure one or more providers. The system dynamically routes and switches between available models.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=

# Runtime AI Router Configuration (auto = dynamic selection)
DEFAULT_AI_PROVIDER=auto
DEFAULT_AI_MODEL=auto
AI_MAX_RETRIES=2
AI_TIMEOUT=30000
AI_FALLBACK_ENABLED=1
AI_STREAMING_ENABLED=1

# Agent Runtime Gateway Port (Default: 8787)
JARVIS_BRIDGE_PORT=8787
VITE_PORT=5173

# Specialized Services (Python AI Core & Rust Native OS Core)
PYTHON_AI_SERVICE_URL=http://127.0.0.1:8790
RUST_NATIVE_SERVICE_URL=http://127.0.0.1:8791
ENABLE_PYTHON_AI=1
ENABLE_RUST_NATIVE=1

# Policy: Allow writes and modifications to local files/system
# 0 = Deny effectful writes without explicit confirmation (Default)
# 1 = Enable writes for approved local developer sessions
JARVIS_ALLOW_WRITES=0

# Security & CORS: Allowed origins for WebSockets and HTTP API
# Comma-separated list of production or dev URLs (e.g., https://gacks-ai.vercel.app)
JARVIS_ALLOWED_ORIGINS=https://gacks-ai.vercel.app
ALLOWED_ORIGINS=https://gacks-ai.vercel.app

# Database Connection (Optional for Postgres, defaults to local persistent JSON DB)
# DATABASE_URL=postgresql://user:pass@ep-host.pooler.neon.tech/gacks_db?sslmode=require

# ElevenLabs Speech Synthesis & Scribe STT (Optional)
# ELEVENLABS_API_KEY=
# JARVIS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Verified Integrations (Optional)
# GITHUB_TOKEN=
# VERCEL_TOKEN=
# EMAIL_HOST=smtp.gmail.com
# EMAIL_USER=
# EMAIL_PASS=
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_ID=

# ===================================================================
# 2. PUBLIC FRONTEND VARIABLES (Vite Client Bundle)
# ===================================================================

# Where the frontend reaches the GACKS Agent Runtime Gateway.
# In local dev: defaults to ws://localhost:8787 and http://localhost:8787
# In production:
#   Persistent WebSocket endpoint:
#   VITE_BRIDGE_URL=wss://your-backend-domain.com/ws
#   Backend REST API endpoint:
#   VITE_API_URL=https://your-backend-domain.com
VITE_BRIDGE_URL=
VITE_API_URL=

# Text-to-Speech Engine for browser playback
# system — Browser speechSynthesis (instant, zero cost, default)
# kokoro — Local neural TTS model running in-browser via ONNX
VITE_TTS_ENGINE=system
VITE_KOKORO_VOICE=bm_george

# Prefer ElevenLabs audio streams when configured on server
VITE_USE_ELEVENLABS=false

# Picovoice Porcupine AccessKey for offline wake-word "Jarvis" (Optional)
# VITE_PICOVOICE_ACCESS_KEY=
